# ---------------------------------------------------------------------------
# Fresh Basket web app + API. Copy to .env.local (development) or set in your host.
# Leave a service's variables empty to run that part in clearly-labelled development mode.
# Never commit real values. Only NEXT_PUBLIC_* values are sent to the browser.
# ---------------------------------------------------------------------------

# Postgres connection used by the server API (the Vercel ↔ Supabase integration sets POSTGRES_URL, which also works).
# Local:    postgres://postgres:postgres@localhost:5432/freshbasket
# Supabase: Project Settings → Database → Connection string (Transaction pooler, port 6543)
DATABASE_URL=

# Public URL of this site (payment links, canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: your final domain once you have one (overrides NEXT_PUBLIC_APP_URL for SEO), e.g. https://www.example.in
NEXT_PUBLIC_SITE_URL=

# --- Ram Avatar Fresh Basket storefront ---
# Seller WhatsApp number for "Order on WhatsApp": international format, digits only, no + / spaces / hyphens.
# Format example only (not a real number): 919876543210.
# Leave empty to use the WhatsApp number saved in Admin → Settings instead (no redeploy needed).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Text shown in the top bar, hero and footer (defaults shown)
NEXT_PUBLIC_SERVICE_AREA=Faridabad & nearby areas
NEXT_PUBLIC_DEFAULT_CITY=Faridabad
NEXT_PUBLIC_DEFAULT_STATE=Haryana

# Accounts to make admin on every deploy (comma-separated). They must have signed up AND confirmed
# their email (Supabase confirmation link) first; unconfirmed accounts are never promoted.
ADMIN_EMAILS=

# Random 32+ character secret used to sign payment links (and dev sessions). REQUIRED in production.
# Generate: openssl rand -base64 48
APP_SECRET=

# --- Supabase Auth + Storage (if empty: development email-only login, local image uploads) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used for product image uploads to Storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- Razorpay (if empty: "Test payment" mode in development, online payment hidden in production) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp order updates (official WhatsApp Business Platform / Cloud API) — server only, optional ---
# Leave empty to turn automatic WhatsApp messages off. Templates must be approved in WhatsApp Manager;
# each takes {{1}} first name, {{2}} order number, {{3}} tracking link.
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_PACKED=
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
# Minutes stock is held while a customer completes online payment
PAYMENT_RESERVATION_MINUTES=15

# Protects /api/cron/release-expired (Vercel Cron sends it automatically as a Bearer token)
CRON_SECRET=

# Comma-separated extra origins allowed to call the API from a browser (e.g. Expo web in development)
EXTRA_ALLOWED_ORIGINS=http://localhost:8081

# Development helpers. ALLOW_DEV_MODE=true re-enables dev login/test payments in a production build — never on a public site.
ALLOW_DEV_MODE=
PAYMENTS_MOCK=
